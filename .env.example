# Telegram-бот, который отправляет заявки с сайта
TELEGRAM_BOT_TOKEN=

# ID личного чата или группы для заявок
TELEGRAM_ADMIN_CHAT_ID=

# Необязательно: только значения content из проверочных метатегов Google и Яндекса.
# Добавьте перед сборкой сайта, когда будете подтверждать владение posadmin.ru.
GOOGLE_SITE_VERIFICATION=
YANDEX_SITE_VERIFICATION=

# Админка прайса. Node.js 24, один сервер и постоянная папка вне public.
# npm run admin:prepare создаёт локальные ключи без вывода секретов в консоль.
ADMIN_EMAIL=a230495k@gmail.com
# На сервере: https://posadmin.ru. Локально: http://localhost:3000
ADMIN_ORIGIN=
ADMIN_ENCRYPTION_KEY=
ADMIN_BOOTSTRAP_TOKEN=
# На сервере, например: /var/lib/posadmin (сохранять между релизами)
POSADMIN_DATA_DIR=
